root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp,cu,cuh}]
indent_style = space
indent_size = 2

[*.{cmake,CMakeLists.txt}]
indent_style = space
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[*.{py,sh}]
indent_style = space
indent_size = 4
